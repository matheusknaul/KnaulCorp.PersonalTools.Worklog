{
  "ConnectionStrings": {
    "Worklog": ""
  },
  "Worklog": {
    "TimeZone": "America/Sao_Paulo"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/KnaulCorp/Worklog/logs/worklog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
